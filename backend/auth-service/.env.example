NODE_ENV=development
PORT=3001

# PostgreSQL (shared instance)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/policylens

# JWT — must be 64+ characters
JWT_ACCESS_SECRET=CHANGE_THIS_TO_A_64_CHAR_RANDOM_STRING_ACCESS_SECRET_KEY_HERE_1234
JWT_REFRESH_SECRET=CHANGE_THIS_TO_A_64_CHAR_RANDOM_STRING_REFRESH_SECRET_KEY_HERE_5678
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Field-level encryption for PII (AES-256-GCM) — 32 hex chars
ENCRYPTION_KEY=CHANGE_THIS_TO_32_CHAR_HEX_STRING

# Internal service-to-service API key
INTERNAL_SERVICE_KEY=CHANGE_THIS_INTERNAL_SERVICE_SECRET

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
