# Auth Service — Environment Variables
# Copy this file to .env and fill in the values

# Server
PORT=3001                        # Port the auth service listens on

# JWT
JWT_SECRET=your-secret-key-min-32-chars-change-me!!   # Minimum 32 characters, used to sign tokens
JWT_ACCESS_EXPIRY=15m            # Access token lifetime
JWT_REFRESH_EXPIRY=7d            # Refresh token lifetime

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8081   # Comma-separated allowed origins

# Bcrypt
BCRYPT_SALT_ROUNDS=12            # Cost factor for password hashing
