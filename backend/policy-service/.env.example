NODE_ENV=development
PORT=3003

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/policylens

JWT_ACCESS_SECRET=CHANGE_THIS_TO_A_64_CHAR_RANDOM_STRING_ACCESS_SECRET_KEY_HERE_1234

INTERNAL_SERVICE_KEY=CHANGE_THIS_INTERNAL_SERVICE_SECRET

AI_SERVICE_URL=http://localhost:3004
AI_SERVICE_INTERNAL_KEY=CHANGE_THIS_AI_SERVICE_KEY

# File storage: "local" for dev, "s3" for prod
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20

# AWS S3 (only needed if STORAGE_DRIVER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=policylens-policies

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=50
