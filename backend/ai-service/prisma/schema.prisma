generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AiScenario {
  id           String       @id @default(uuid())
  userId       String       @map("user_id")
  query        String
  scenarioType ScenarioType @map("scenario_type")
  pathA        Json         @map("path_a")
  pathB        Json         @map("path_b")
  delta        Json
  narrative    String
  confidence   Confidence
  createdAt    DateTime     @default(now()) @map("created_at")

  @@map("ai_scenarios")
  @@index([userId])
}

model AiParseJob {
  id          String    @id @default(uuid())
  policyId    String    @map("policy_id")
  userId      String    @map("user_id")
  status      JobStatus @default(queued)
  result      Json?
  errorMsg    String?   @map("error_msg")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("ai_parse_jobs")
  @@index([userId])
  @@index([policyId])
}

enum ScenarioType {
  income_shock
  medical
  policy_change
  property
}

enum Confidence {
  high
  medium
  low
}

enum JobStatus {
  queued
  processing
  done
  failed
}
