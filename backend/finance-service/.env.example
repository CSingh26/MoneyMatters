# Finance Service — Environment Variables
# Copy this file to .env and fill in the values

# Server
PORT=3002                        # Port the finance service listens on

# JWT
JWT_SECRET=your-secret-key-min-32-chars-change-me!!   # Must match auth-service secret

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8081   # Comma-separated allowed origins
